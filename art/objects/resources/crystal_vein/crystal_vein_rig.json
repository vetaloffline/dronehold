 "shard_motion": "s = sin((t/period + phase)*2pi); y = center.y - s*bob_amp; rotation = sway*sin((t/(period*1.7)+phase)*2pi); scale.x *= 1 - spin*(0.5-0.5*cos((t/(period*1.3)+phase)*2pi))",
 "shard_glow": {
  "radius_at_scale_0.3": 83,
  "alpha": 0.55,
  "pulse": 0.51,
  "color": "#4fb6ff",
  "blend": "add",
  "formula": "alpha*(1 - pulse*0.5 + pulse*0.5*s)"
 },
 "shard_shadow": {
  "alpha": 0.28,
  "radius_at_scale_0.3": 48,
  "dx_per_px_height": -0.3,
  "shrink": 0.45,
  "color": [
   3,
   11,
   26
  ],
  "formula": "h = height + s*bob_amp; k = max(0.15, 1 - shrink*h/900); ellipse at (x + dx*h, y + h), rx = r*k, ry = 0.35*r*k, alpha*k"
 },
